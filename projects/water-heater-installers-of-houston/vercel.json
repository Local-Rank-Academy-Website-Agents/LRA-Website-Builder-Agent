{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "waterheaterinstallation-houston.com"
        }
      ],
      "destination": "https://www.waterheaterinstallation-houston.com/:path*",
      "permanent": true
    }
  ]
}
